# Copy to .env (optional). All values are local-only defaults.
# Port for the local gym server.
OVERFIT_PORT=4377
# Bind address. Keep 127.0.0.1 unless you understand the exposure.
OVERFIT_HOST=127.0.0.1
# Where the ingest log (events.jsonl) is written. Gitignored.
OVERFIT_DATA_DIR=./data
# Extra hostnames allowed in Host/Origin headers (comma separated), e.g. when a
# local reverse proxy serves the gym under a friendly name. localhost and
# 127.0.0.1 are always allowed.
OVERFIT_ALLOWED_HOSTS=
# Default art direction per hostname (comma separated host=look). Looks: default, film80.
# Anyone can also pick one with ?look=film80 in the URL.
OVERFIT_LOOK_HOSTS=
